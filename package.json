{
  "name": "@askcal/mcp-server",
  "version": "0.2.0",
  "description": "MCP server for Cal, the AI mortgage platform at askcal.io. Exposes Cal's wholesale lender library, DPA programs, lender intel, ValueGuard valuations, and loan-limit and fee facts to any MCP-compatible client (Claude Desktop, Cursor, Continue, Goose, Zed). Live library figures: askcal.io/status.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cal-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "model-context-protocol",
    "claude",
    "claude-desktop",
    "mortgage",
    "home-loans",
    "lender",
    "lending",
    "real-estate",
    "fha",
    "va",
    "fannie-mae",
    "freddie-mac",
    "dpa",
    "valuation",
    "askcal",
    "cal"
  ],
  "homepage": "https://askcal.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/askcal/cal-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/askcal/cal-mcp-server/issues"
  },
  "author": "Chris Black <chris@askcal.io> (https://askcal.io)",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3"
  }
}
